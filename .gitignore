.env
.venv/
__pycache__/
*.pyc
storage/inputs/*
storage/results/*
storage/jobs.db
!storage/inputs/.gitkeep
!storage/results/.gitkeep
projects/
engines/

# working media: source clips, frames, and rendered output are not source code
*.mp4
*.m4a
*.wav
artifacts/
physical-board-*.jpg
physical-board-*.png
board-layout.jpg
!samples/*.pgn
!samples/*.json

# cached OpenRouter model list (prices change; refetched on demand)
openrouter-models.json

# exported browser login for yt-dlp (core/video.cookie_file) -- never commit
cookies.txt

# per-channel upload description/tags (contact email, donation links)
upload-templates.json

# runtime log (shell redirect target; regenerated on every run)
server.log

# background music for manual editing -- not a move sound clip
assets/sounds/Tame Impala.MP3

# yt-dlp leftover download fragments
tmp*.tmp-Frag*
