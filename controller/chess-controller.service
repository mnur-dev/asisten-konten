[Unit]
Description=Chess Automation Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/chess-automation
EnvironmentFile=/home/ubuntu/chess-automation/.env
ExecStart=/home/ubuntu/chess-automation/.venv/bin/uvicorn controller.app:app --host 127.0.0.1 --port 8767 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/chess-automation/storage

[Install]
WantedBy=multi-user.target
